# ==========================================================================
# FX Scalper Lab - Environment Configuration
# Copy to .env and fill in values. NEVER commit the real .env file.
# ==========================================================================

# --- General ---
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# Random value, at least 32 chars outside development/test.
# Generate: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256
JWT_ISSUER=fxscalper-lab

# Base64 32-byte key used for field-level encryption at rest.
# Generate: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# REQUIRED when APP_ENV != development/test (backend refuses to start without it).
DATA_ENCRYPTION_KEY=

# --- Database (PostgreSQL) ---
POSTGRES_USER=fxscalper
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fxscalper
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://fxscalper:change-me@localhost:5432/fxscalper

# --- Redis (rate limiting / job queue) ---
REDIS_URL=redis://localhost:6379/0

# --- LLM (OpenAI-compatible endpoint) ---
# Leave LLM_PROVIDER=mock for offline development.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Broker / Data providers ---
MARKET_DATA_PROVIDER=mock
BROKER_PROVIDER=simulated

# Real-data providers (leave blank unless you have credentials)
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice
TWELVEDATA_API_KEY=

# --- Practice / live execution ---
LIVE_TRADING_ENABLED=false
BROKER_PRACTICE_DRY_RUN=true

# --- Security controls ---
# JSON array of allowed CORS origins for the browser frontend.
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
# Set true when serving behind a trusted reverse proxy that strips X-Forwarded-For.
TRUST_PROXY_HEADERS=false
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_MAX_ATTEMPTS_PER_WINDOW=10
AUTH_LOGIN_WINDOW_SECONDS=600
# Enables Strict-Transport-Security when the app is served behind HTTPS.
ENABLE_HSTS=false

# Maximum CSV upload size for market-data import (bytes).
UPLOAD_MAX_BYTES=8388608

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api