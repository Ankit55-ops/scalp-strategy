# ==========================================================================
# FX Scalper Lab - Environment Configuration
# Copy to .env and fill in values. NEVER commit the real .env file.
# ==========================================================================

# --- General ---
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (PostgreSQL) ---
POSTGRES_USER=fxscalper
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fxscalper
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://fxscalper:change-me@localhost:5432/fxscalper

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM (OpenAI-compatible endpoint) ---
# Leave LLM_PROVIDER=mock for offline development.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Broker / Data providers ---
MARKET_DATA_PROVIDER=mock
BROKER_PROVIDER=simulated

# --- Security ---
ENABLE_CSRF=false

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
